# =============================================================================
# Yaya Alanı İhlal Platformu — Kök ortam değişkenleri
# Kullanım:  cp .env.example .env  ve değerleri doldurun.
# .env dosyası ASLA commit edilmez.
# =============================================================================

# -----------------------------------------------------------------------------
# Genel
# -----------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
TZ=Europe/Istanbul
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (docker compose)
# -----------------------------------------------------------------------------
POSTGRES_DB=yaya
POSTGRES_USER=yaya
POSTGRES_PASSWORD=yaya_dev_password
POSTGRES_PORT=5432

# API için bağlantı adresi. Yerel Docker için aşağıdaki varsayılan kullanılır.
# Supabase kullanıyorsanız: postgresql://postgres.<ref>:<sifre>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://yaya:yaya_dev_password@localhost:5432/yaya
# Bağlantı havuzu üst sınırı
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Node.js API
# NOT: 3000/8000 portları yerel makinede başka projeler tarafından kullanıldığı
# için host portları 3001/8001 olarak ayarlanmıştır. Konteyner içi portlar
# değişmez (API 3000, AI 8000).
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3002,http://localhost:8081

# KVKK: yüz/plaka anonimleştirme (AI servisinin /v1/anonymize ucu).
# ANONYMIZATION_REQUIRED=true iken anonimleştirme başarısızsa ihbar 503 ile
# reddedilir ve anonimlenmemiş kayıt yazılmaz. Üretimde true önerilir.
ANONYMIZATION_ENABLED=true
ANONYMIZATION_REQUIRED=true
ANONYMIZATION_TIMEOUT_MS=10000
# Görsellerin saklama süresi (gün). retention_expires_at bu süre sonrasına yazılır.
RETENTION_DAYS=730
# Temizlik işi (npm run retention:purge) parti boyutu ve üst sınırı.
RETENTION_PURGE_BATCH_SIZE=200
RETENTION_PURGE_MAX_BATCHES=50

# -----------------------------------------------------------------------------
# AI Servisi (FastAPI)
# -----------------------------------------------------------------------------
AI_PORT=8001
AI_SERVICE_URL=http://localhost:8001
MODEL_DIR=./models
DETECTOR_MODEL_FILE=detector.onnx
SEGMENTER_MODEL_FILE=segmenter.onnx
DETECTOR_OUTPUT_FORMAT=yolo
DETECTOR_INPUT_SIZE=640
SEGMENTER_INPUT_SIZE=512
DETECTOR_CONFIDENCE_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
MAX_DETECTIONS=50
MODEL_CLASSES=
ANALYSIS_MAX_DIMENSION=1024
MAX_IMAGE_DIMENSION=4096
ONNX_INTRA_OP_THREADS=2
SCORE_TEMPERATURE=1.0
# Geliştirmede ağırlık yoksa yedek hat; üretimde false yapın.
ALLOW_HEURISTIC_FALLBACK=true
# KVKK: gerçek yüz/plaka modeli yokken sezgisel bulanıklaştırma.
# Üretimde doğrulanmış model bağlanana kadar false yapıp anonimleştirmeyi
# kapatabilirsiniz (POST /v1/anonymize 503 döner).
ALLOW_HEURISTIC_ANONYMIZATION=true
WARMUP_ON_STARTUP=true
CONFIDENCE_THRESHOLD_AUTO_ACCEPT=0.85
CONFIDENCE_THRESHOLD_MANUAL_REVIEW=0.60

# -----------------------------------------------------------------------------
# Görsel depolama
# -----------------------------------------------------------------------------
# local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# Tek görsel için üst sınır (MB)
MAX_UPLOAD_MB=12

# Supabase Storage / yönetim paneli entegrasyonu (opsiyonel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reports

# -----------------------------------------------------------------------------
# Expo mobil uygulaması (Faz 1)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_AI_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Web paneli (Faz 4) — Next.js
# -----------------------------------------------------------------------------
# Panel sunucu tarafından API'ye bağlanır; tarayıcı doğrudan API'ye gitmez.
# Docker Compose içinde servis adı kullanılabilir: http://api:3000
API_INTERNAL_URL=http://localhost:3001
# Oturum çerezini (HMAC) imzalayan sır. Üretimde en az 32 bayt rastgele değer.
# Boş bırakılırsa yalnızca geliştirme için varsayılan sır kullanılır.
WEB_SESSION_SECRET=
# Geliştirme demo kullanıcıları (moderatör, yönetici, izleyici). Üretimde false.
WEB_DEV_AUTH=true
# Supabase Auth (opsiyonel). Tanımlıysa e-posta/parola ile kurumsal giriş açılır.
# NEXT_PUBLIC_SUPABASE_URL ve NEXT_PUBLIC_SUPABASE_ANON_KEY de kabul edilir.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opsiyonel MapLibre stil URL'si. Boşsa OpenStreetMap raster altlığı kullanılır.
NEXT_PUBLIC_MAP_STYLE_URL=
