{
  "name": "@yaya/api",
  "version": "0.1.0",
  "private": true,
  "description": "Yaya alanı ihlal platformu REST API (Fastify + TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "retention:purge": "tsx src/scripts/purge-retention.ts",
    "retention:purge:prod": "node dist/scripts/purge-retention.js",
    "seed:istanbul": "tsx src/scripts/seed-istanbul.ts",
    "migrate:up": "node-pg-migrate up --envPath ../../.env",
    "migrate:down": "node-pg-migrate down --envPath ../../.env",
    "migrate:create": "node-pg-migrate create --envPath ../../.env"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.9",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "fastify": "^5.2.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
