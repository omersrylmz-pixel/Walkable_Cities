{
  "name": "yaya-alani-ihlal-platformu",
  "version": "0.1.0",
  "private": true,
  "description": "Yapay zekâ ile yaya alanı ihlal tespiti ve şehir analiz platformu (TÜBİTAK 2209-A)",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace @yaya/api",
    "api:build": "npm run build --workspace @yaya/api",
    "api:start": "npm run start --workspace @yaya/api",
    "api:test": "npm test --workspace @yaya/api",
    "api:test:integration": "npm run test:integration --workspace @yaya/api",
    "mobile:start": "npm run start --workspace @yaya/mobile",
    "mobile:android": "npm run android --workspace @yaya/mobile",
    "mobile:ios": "npm run ios --workspace @yaya/mobile",
    "web:dev": "npm run dev --workspace @yaya/web",
    "web:build": "npm run build --workspace @yaya/web",
    "web:start": "npm run start --workspace @yaya/web",
    "web:test": "npm test --workspace @yaya/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  }
}
