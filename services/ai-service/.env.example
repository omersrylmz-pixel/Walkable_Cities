ENVIRONMENT=development
LOG_LEVEL=info

# ONNX ağırlık dizini (göreli veya mutlak)
MODEL_DIR=./models
DETECTOR_MODEL_FILE=detector.onnx
SEGMENTER_MODEL_FILE=segmenter.onnx

# Model sözleşmesi
# DETECTOR_OUTPUT_FORMAT: yolo | detr
DETECTOR_OUTPUT_FORMAT=yolo
DETECTOR_INPUT_SIZE=640
SEGMENTER_INPUT_SIZE=512
DETECTOR_CONFIDENCE_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
MAX_DETECTIONS=50

# Virgülle ayrılmış sınıf listesi. Boşsa models/classes.json, o da yoksa
# yerleşik şema kullanılır.
MODEL_CLASSES=

# Analiz öncesi görselin uzun kenarı bu değere indirilir (hız / bellek).
ANALYSIS_MAX_DIMENSION=1024
MAX_UPLOAD_MB=12
MAX_IMAGE_DIMENSION=4096
ONNX_INTRA_OP_THREADS=2

# Skor kalibrasyonu (temperature scaling; 1.0 = kalibrasyon yok)
SCORE_TEMPERATURE=1.0

# Ağırlıklar yoksa deterministik yedek hat (yalnızca geliştirme/CI).
# Üretimde false yapın; model yoksa /health/ready 503 döner.
ALLOW_HEURISTIC_FALLBACK=true
WARMUP_ON_STARTUP=true

# Karar eşikleri — veritabanındaki system_setting ile aynı tutulmalı
AUTO_ACCEPT_THRESHOLD=0.85
MANUAL_REVIEW_THRESHOLD=0.60

CORS_ORIGINS=http://localhost:3002,http://localhost:3001
